# Copy to .env for local testing only. NEVER commit a real .env.
# In Vercel, set these in Dashboard -> Settings -> Environment Variables.
SECRET_KEY=change-me-to-a-long-random-string
DB_URI=mongodb+srv://username:password@cluster.mongodb.net/bot_database?retryWrites=true&w=majority
# Cloudflare Turnstile (https://dash.cloudflare.com -> Turnstile -> Add site)
# Turnstile is only enforced when BOTH keys are set.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Chrome-only gate: true (default) / false
CHROME_ONLY=true
# Optional: lock down POST /api/create-token (bot sends X-Api-Key header)
BOT_API_KEY=
# Required for GET /api/sessions (send as X-Admin-Key header)
ADMIN_KEY=change-me-to-a-long-random-string
# Optional rate-limit overrides (defaults 10 / 70, like LinkForge)
RATE_LIMIT_PER_MINUTE=10
RATE_LIMIT_PER_HOUR=70
